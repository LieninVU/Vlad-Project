<Window x:Class="ForVlad.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ForVlad.Views"
        xmlns:behaviors="clr-namespace:ForVlad.Behaviors"
        Title="Система учёта договоров аренды и лизинга спецтехники" 
        Height="700" Width="1100"
        MinWidth="800" MinHeight="500"
        Background="#ECF0F1"
        WindowStartupLocation="CenterScreen"
        behaviors:WindowScalingBehavior.IsEnabled="True"
        behaviors:WindowScalingBehavior.BaseWidth="1100"
        behaviors:WindowScalingBehavior.BaseHeight="700">
    
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,2"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#34495E"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- Боковая панель навигации -->
        <Border Grid.Column="0" Background="#2C3E50">
            <DockPanel>
                <!-- Заголовок приложения -->
                <Border DockPanel.Dock="Top" Background="#1A252F" Padding="15">
                    <TextBlock Text="Аренда спецтехники" 
                               Foreground="White" 
                               FontSize="16" 
                               FontWeight="Bold"/>
                </Border>
                
                <!-- Навигационные кнопки -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <TextBlock Text="ОСНОВНОЕ" 
                                   Foreground="#95A5A6" 
                                   FontSize="11" 
                                   FontWeight="Bold" 
                                   Margin="0,10,0,5"/>
                        
                        <Button Content="📋 Договоры" 
                                Command="{Binding NavigateToContractsCommand}"/>
                        
                        <Button Content="🚜 Техника и оборудование" 
                                Command="{Binding NavigateToAssetsCommand}"/>
                        
                        <Button Content="👥 Контрагенты" 
                                Command="{Binding NavigateToCounterpartiesCommand}"/>
                        
                        <TextBlock Text="ОТЧЕТЫ" 
                                   Foreground="#95A5A6" 
                                   FontSize="11" 
                                   FontWeight="Bold" 
                                   Margin="0,20,0,5"/>
                        
                        <Button Content="📊 Действующие договоры" 
                                Command="{Binding NavigateToActiveContractsCommand}"/>
                        
                        <Button Content="💰 Финансовые отчеты" 
                                Command="{Binding NavigateToFinancialReportsCommand}"/>
                        
                        <Button Content="📈 Загрузка техники" 
                                Command="{Binding NavigateToUtilizationReportsCommand}"/>
                        
                        <TextBlock Text="СИСТЕМА" 
                                   Foreground="#95A5A6" 
                                   FontSize="11" 
                                   FontWeight="Bold" 
                                   Margin="0,20,0,5"/>
                        
                        <Button Content="⚙️ Настройки" 
                                Command="{Binding NavigateToSettingsCommand}"/>
                        
                        <!-- Статус приложения -->
                        <Border Margin="0,30,0,0" Padding="10" Background="#34495E" CornerRadius="5">
                            <TextBlock Text="{Binding StatusMessage}" 
                                       Foreground="#BDC3C7" 
                                       FontSize="10" 
                                       TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
        
        <!-- Основная рабочая область -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Панель заголовка текущего раздела -->
            <Border Grid.Row="0" Background="#3498DB" Padding="15,12">
                <DockPanel LastChildFill="True">
                    <!-- Кнопки действий — справа, не перекрывают заголовок -->
                    <ContentControl DockPanel.Dock="Right"
                                    Content="{Binding CurrentViewActions}"
                                    VerticalAlignment="Center"
                                    Margin="16,0,0,0">
                        <ContentControl.Resources>
                            <DataTemplate DataType="{x:Type local:ContractsView}">
                                <Button Content="+ Новый договор" 
                                        Background="#2ECC71" 
                                        Foreground="White"
                                        Padding="10,5"
                                        Command="{Binding DataContext.AddContractCommand}"/>
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type local:AssetsView}">
                                <Button Content="+ Добавить технику" 
                                        Background="#2ECC71" 
                                        Foreground="White"
                                        Padding="10,5"
                                        Command="{Binding DataContext.AddAssetCommand}"/>
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type local:CounterpartiesView}">
                                <Button Content="+ Новый контрагент" 
                                        Background="#2ECC71" 
                                        Foreground="White"
                                        Padding="10,5"
                                        Command="{Binding DataContext.AddCounterpartyCommand}"/>
                            </DataTemplate>
                        </ContentControl.Resources>
                    </ContentControl>
                    
                    <TextBlock Text="{Binding CurrentViewTitle}" 
                               Foreground="White" 
                               FontSize="18" 
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"/>
                </DockPanel>
            </Border>
            
            <ContentControl Grid.Row="1" Content="{Binding CurrentView}"/>
            
            <!-- Строка состояния (по спецификации MainWindow.StatusBar) -->
            <Border Grid.Row="2" Background="#ECF0F1" BorderBrush="#BDC3C7" BorderThickness="0,1,0,0" Padding="10,6">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding AppVersion, StringFormat=Версия {0}}"
                               Foreground="#7F8C8D" FontSize="11" Margin="16,0,0,0"/>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding ConnectionStatus}"
                               Foreground="#7F8C8D" FontSize="11" Margin="16,0,0,0"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#2C3E50" FontSize="11"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>