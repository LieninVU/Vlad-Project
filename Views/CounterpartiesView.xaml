<UserControl x:Class="ForVlad.Views.CounterpartiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:ForVlad.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="800">
    
    <UserControl.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="MinWidth" Value="80"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Margin" Value="2"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="MinWidth" Value="120"/>
        </Style>
        <converters:IntToVisibilityConverter x:Key="IntToVisibilityConverter" />
        <converters:IntToVisibilityInverseConverter x:Key="IntToVisibilityInverseConverter" />
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <Border Grid.Row="0" Background="#F8F9FA" Padding="10" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <Button Content="+ Новый контрагент" Background="#2ECC71" Foreground="White" FontWeight="Bold"
                        Command="{Binding AddCounterpartyCommand}"/>
                <Button Content="✏️ Редактировать" Background="#3498DB" Foreground="White"
                        Command="{Binding EditCounterpartyCommand}"/>
                <Button Content="🗑️ Удалить" Background="#E74C3C" Foreground="White"
                        Command="{Binding DeleteCounterpartyCommand}"/>
                <Button Content="📋 Договоры" Background="#9B59B6" Foreground="White"
                        Command="{Binding ViewContractsCommand}"
                        ToolTip="Перейти к договорам контрагента"/>
                <Button Content="🔄 Обновить" Background="#95A5A6" Foreground="White"
                        Command="{Binding RefreshCommand}" Margin="20,0,0,0"/>
            </StackPanel>
        </Border>
        
        <Border Grid.Row="1" Background="#ECF0F1" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Поиск:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Поиск по названию, ИНН, контакту, телефону, email..." MinWidth="200"/>
            </Grid>
        </Border>
        
        <Border Grid.Row="2" Background="#F8F9FA" Padding="8,6" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding FilteredCounterparties.Count, StringFormat=Найдено: {0}}" Margin="0,0,16,0"/>
                <TextBlock Text="{Binding Counterparties.Count, StringFormat=Всего в базе: {0}}"/>
            </StackPanel>
        </Border>
        
        <Grid Grid.Row="3">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Height="400">
                <StackPanel>
                    <DataGrid ItemsSource="{Binding FilteredCounterparties}"
                              SelectedItem="{Binding SelectedCounterparty}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              GridLinesVisibility="None"
                              RowBackground="#FFFFFF"
                              AlternatingRowBackground="#F8F9FA"
                              HeadersVisibility="Column"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              CanUserResizeRows="False"
                              CanUserSortColumns="True"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Disabled"
                              MinWidth="900"
                              Visibility="{Binding HasCounterparties, Converter={StaticResource IntToVisibilityConverter}}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="200" MinWidth="150"/>
                    <DataGridTextColumn Header="Тип" Binding="{Binding CounterpartyType, Converter={StaticResource EnumToRussianConverter}}" Width="110" MinWidth="90"/>
                    <DataGridTextColumn Header="ИНН" Binding="{Binding INN}" Width="110" MinWidth="100"/>
                    <DataGridTextColumn Header="Контактное лицо" Binding="{Binding ContactPerson}" Width="150" MinWidth="120"/>
                    <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="120" MinWidth="100"/>
                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="160" MinWidth="120"/>
                    <DataGridTextColumn Header="Юр. адрес" Binding="{Binding LegalAddress}" Width="200" MinWidth="150"/>
                    <DataGridTextColumn Header="Создан" Binding="{Binding CreatedDate, StringFormat=dd.MM.yyyy}" Width="90" MinWidth="80"/>
                    <DataGridTemplateColumn Header="Действия" Width="75" MinWidth="75">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="✏️" ToolTip="Редактировать" Padding="4,2" FontSize="10"
                                        Command="{Binding DataContext.EditCounterpartyFromRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#ECF0F1"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F2F4F4"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#D6EAF8"/>
                                <Setter Property="BorderBrush" Value="#3498DB"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#D6EAF8"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>
            </DataGrid>

            <Border Background="#F8F9FA"
                    Visibility="{Binding HasCounterparties, Converter={StaticResource IntToVisibilityInverseConverter}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="👥" FontSize="48" Foreground="#BDC3C7" HorizontalAlignment="Center"/>
                    <TextBlock Text="Контрагенты не найдены" FontSize="16" Foreground="#7F8C8D" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                    <TextBlock Text="Измените поиск или добавьте нового контрагента" FontSize="12" Foreground="#95A5A6" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        
        <Border Grid.Row="0" Grid.RowSpan="4" Background="#80000000"
                Visibility="{Binding IsDialogOpen, Converter={StaticResource IntToVisibilityConverter}}">
            <Border Background="White" Width="560" MaxHeight="620" CornerRadius="5" Padding="20"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding DialogTitle}" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"><Run Text="Наименование:"/><Run Text=" *" Foreground="Red" FontWeight="Bold"/></TextBlock>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding EditingCounterparty.Name, UpdateSourceTrigger=PropertyChanged}" Margin="5"/>
                            
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Тип:" VerticalAlignment="Center"/>
<ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding CounterpartyTypes}"
                          SelectedItem="{Binding EditingCounterparty.CounterpartyType}" Margin="5">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumToRussianConverter}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                            
                            <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"><Run Text="ИНН:"/><Run Text=" *" Foreground="Red" FontWeight="Bold"/></TextBlock>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding EditingCounterparty.INN, UpdateSourceTrigger=PropertyChanged}" Margin="5"/>
                            
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="КПП:" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding EditingCounterparty.KPP, UpdateSourceTrigger=PropertyChanged}" Margin="5"/>
                            
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Контактное лицо:" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding EditingCounterparty.ContactPerson, UpdateSourceTrigger=PropertyChanged}" Margin="5"/>
                            
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Телефон:" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding EditingCounterparty.Phone, UpdateSourceTrigger=PropertyChanged}" Margin="5"/>
                            
                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Email:" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding EditingCounterparty.Email, UpdateSourceTrigger=PropertyChanged}" Margin="5"/>
                            
                            <TextBlock Grid.Row="7" Grid.Column="0" Text="Юр. адрес:" VerticalAlignment="Top" Margin="0,8,0,0"/>
                            <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding EditingCounterparty.LegalAddress, UpdateSourceTrigger=PropertyChanged}"
                                     TextWrapping="Wrap" Height="50" Margin="5"/>
                            
                            <TextBlock Grid.Row="8" Grid.Column="0" Text="Факт. адрес:" VerticalAlignment="Top" Margin="0,8,0,0"/>
                            <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding EditingCounterparty.ActualAddress, UpdateSourceTrigger=PropertyChanged}"
                                     TextWrapping="Wrap" Height="50" Margin="5"/>
                            
                            <TextBlock Grid.Row="9" Grid.Column="0" Text="Примечания:" VerticalAlignment="Top" Margin="0,8,0,0"/>
                            <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding EditingCounterparty.Notes, UpdateSourceTrigger=PropertyChanged}"
                                     TextWrapping="Wrap" Height="50" Margin="5"/>
                            
                            <CheckBox Grid.Row="10" Grid.Column="1" Content="Активен" IsChecked="{Binding EditingCounterparty.IsActive}" Margin="5,8,5,0"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                            <Button Content="Сохранить" Background="#2ECC71" Foreground="White" FontWeight="Bold" Width="100" Margin="0,0,10,0"
                                    Command="{Binding SaveCounterpartyCommand}"/>
                            <Button Content="Отмена" Background="#95A5A6" Foreground="White" Width="100"
                                    Command="{Binding CancelCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Border>
    </Grid>
</UserControl>
