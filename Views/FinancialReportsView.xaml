<UserControl x:Class="ForVlad.Views.FinancialReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:ForVlad.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="900">
    <UserControl.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="MinWidth" Value="90"/>
        </Style>
        <converters:IntToVisibilityConverter x:Key="BoolVisConverter" />
        <converters:IntToVisibilityInverseConverter x:Key="BoolVisInverseConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <Border Grid.Row="0" Background="#F8F9FA" Padding="10" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="Финансовые отчёты — дебиторская задолженность и реестр платежей"
                           FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="🔄 Обновить" Background="#3498DB" Foreground="White" Command="{Binding RefreshCommand}"/>
                    <Button Content="✓ Платёж" Background="#2ECC71" Foreground="White"
                            Command="{Binding MarkPaidCommand}"/>
                    <Button Content="✗ Договор не оплачен" Background="#E74C3C" Foreground="White"
                            Command="{Binding MarkUnpaidCommand}"/>
                    <Button Content="📤 Экспорт CSV" Background="#27AE60" Foreground="White"
                            Command="{Binding ExportToCsvCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>
        
        <Border Grid.Row="1" Background="#ECF0F1" Padding="10" Margin="0,0,0,8">
            <StackPanel>
                <WrapPanel Orientation="Horizontal">
                    <TextBlock Text="Срок с:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <DatePicker SelectedDate="{Binding DueDateFrom}"
                                Width="150" Margin="0,0,16,0" />
                    <TextBlock Text="по:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <DatePicker SelectedDate="{Binding DueDateTo}"
                                Width="150" Margin="0,0,16,0" />
                    <CheckBox Content="Только неоплаченные" IsChecked="{Binding UnpaidOnly}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Button Content="Применить" Background="#3498DB" Foreground="White" Command="{Binding ApplyFiltersCommand}"/>
                    <Button Content="Сбросить" Background="#95A5A6" Foreground="White" Command="{Binding ClearFiltersCommand}"/>
                </WrapPanel>
                <TextBlock Text="💡 Просрочка рассчитывается как: текущая дата - срок оплаты (если не оплачено). Категории: Текущий (до срока), 1–7 дн., 8–30 дн., 30+ дн."
                           FontSize="11" Foreground="#7F8C8D" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
        
        <Border Grid.Row="2" Background="#F8F9FA" Padding="8,6" Margin="0,0,0,8">
            <WrapPanel>
                <TextBlock Text="{Binding Summary.PaymentCount, StringFormat=Платежей: {0}}" Margin="0,0,20,0"/>
                <TextBlock Text="{Binding Summary.TotalDue, StringFormat=К оплате: {0:N2} ₽}" Margin="0,0,20,0"/>
                <TextBlock Text="{Binding Summary.TotalOverdue, StringFormat=Просрочено: {0:N2} ₽}" Foreground="#E74C3C" Margin="0,0,20,0"/>
                <TextBlock Text="{Binding Summary.TotalPaidInPeriod, StringFormat=Оплачено за период: {0:N2} ₽}" Foreground="#27AE60"/>
            </WrapPanel>
        </Border>
        
        <Grid Grid.Row="3">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Height="400">
                <StackPanel>
                    <DataGrid ItemsSource="{Binding Payments}"
                              SelectedItem="{Binding SelectedPayment}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              GridLinesVisibility="None"
                              RowBackground="#FFFFFF"
                              AlternatingRowBackground="#F8F9FA"
                              HeadersVisibility="Column"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              CanUserResizeRows="False"
                              CanUserSortColumns="True"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Disabled"
                              MinWidth="900"
                              Visibility="{Binding HasPayments, Converter={StaticResource BoolVisConverter}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Договор" Binding="{Binding ContractNumber}" Width="110" MinWidth="100" SortMemberPath="ContractNumber"/>
                            <DataGridTextColumn Header="Контрагент" Binding="{Binding CounterpartyName}" Width="160" MinWidth="140" SortMemberPath="CounterpartyName"/>
                            <DataGridTextColumn Header="Срок" Binding="{Binding DueDate, StringFormat=dd.MM.yyyy}" Width="90" MinWidth="85" SortMemberPath="DueDate"/>
                            <DataGridTextColumn Header="Сумма" Binding="{Binding TotalAmount, StringFormat=N2}" Width="95" MinWidth="90" SortMemberPath="TotalAmount"/>
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status, Converter={StaticResource EnumToRussianConverter}}" Width="90" MinWidth="80" SortMemberPath="Status"/>
                            <DataGridTextColumn Header="Просрочка" Binding="{Binding DaysOverdue}" Width="80" MinWidth="70" SortMemberPath="DaysOverdue"/>
                            <DataGridTextColumn Header="Категория" Binding="{Binding AgingBucket}" Width="90" MinWidth="80" SortMemberPath="AgingBucket"/>
                            <DataGridTextColumn Header="Оплачен" Binding="{Binding IsPaid, Converter={StaticResource EnumToRussianConverter}}" Width="70" MinWidth="65" SortMemberPath="IsPaid"/>
                        </DataGrid.Columns>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#ECF0F1"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#D6EAF8"/>
                                        <Setter Property="BorderBrush" Value="#3498DB"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F2F4F4"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="8,6"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="Transparent"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>
                    </DataGrid>
                    <Border Background="#F8F9FA" Visibility="{Binding HasPayments, Converter={StaticResource BoolVisInverseConverter}}">
                        <TextBlock Text="Нет платежей по выбранным фильтрам" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="#7F8C8D" FontSize="14"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
