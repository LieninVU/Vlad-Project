<Window x:Class="ForVlad.Views.MainWindowSimple"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ForVlad.ViewModels"
        xmlns:behaviors="clr-namespace:ForVlad.Behaviors"
        Title="Система учёта договоров аренды и лизинга спецтехники" 
        Height="600" Width="900"
        MinWidth="700" MinHeight="450"
        Background="#ECF0F1"
        WindowStartupLocation="CenterScreen"
        behaviors:WindowScalingBehavior.IsEnabled="True"
        behaviors:WindowScalingBehavior.BaseWidth="900"
        behaviors:WindowScalingBehavior.BaseHeight="600">
    
    <Window.DataContext>
        <local:MainViewModel />
    </Window.DataContext>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- Боковое меню -->
        <Border Grid.Column="0" Background="#2C3E50">
            <StackPanel Margin="10">
                <TextBlock Text="Навигация" 
                           Foreground="White" 
                           FontSize="16" 
                           FontWeight="Bold" 
                           Margin="0,0,0,20"/>
                
                <Button Content="📋 Договоры" 
                        Background="Transparent"
                        Foreground="White"
                        BorderThickness="0"
                        HorizontalContentAlignment="Left"
                        Padding="10,8"
                        Margin="0,2"
                        Command="{Binding NavigateToContractsCommand}"/>
                
                <Button Content="👥 Контрагенты" 
                        Background="Transparent"
                        Foreground="White"
                        BorderThickness="0"
                        HorizontalContentAlignment="Left"
                        Padding="10,8"
                        Margin="0,2"
                        Command="{Binding NavigateToCounterpartiesCommand}"/>
                
                <Button Content="🚜 Техника" 
                        Background="Transparent"
                        Foreground="White"
                        BorderThickness="0"
                        HorizontalContentAlignment="Left"
                        Padding="10,8"
                        Margin="0,2"
                        Command="{Binding NavigateToVehiclesCommand}"/>
                
                <Button Content="⚙️ Оборудование" 
                        Background="Transparent"
                        Foreground="White"
                        BorderThickness="0"
                        HorizontalContentAlignment="Left"
                        Padding="10,8"
                        Margin="0,2"
                        Command="{Binding NavigateToEquipmentCommand}"/>
                
                <Button Content="📊 Отчёты" 
                        Background="Transparent"
                        Foreground="White"
                        BorderThickness="0"
                        HorizontalContentAlignment="Left"
                        Padding="10,8"
                        Margin="0,2"
                        Command="{Binding NavigateToReportsCommand}"/>
                
                <Button Content="⚙️ Настройки" 
                        Background="Transparent"
                        Foreground="White"
                        BorderThickness="0"
                        HorizontalContentAlignment="Left"
                        Padding="10,8"
                        Margin="0,20,0,0"
                        Command="{Binding NavigateToSettingsCommand}"/>
            </StackPanel>
        </Border>
        
        <!-- Основная область -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Статус -->
            <Border Grid.Row="0" Background="#E8F4FD" Padding="5" Margin="5">
                <TextBlock Text="{Binding StatusMessage}" 
                           Foreground="#2C3E50" 
                           FontSize="12" 
                           HorizontalAlignment="Center"/>
            </Border>
            
            <!-- Заголовок -->
            <Border Grid.Row="1" Background="#3498DB" Padding="10">
                <TextBlock Text="{Binding CurrentViewTitle}" 
                           Foreground="White" 
                           FontSize="18" 
                           FontWeight="Bold"/>
            </Border>
            
            <!-- Контент -->
            <Border Grid.Row="2" Margin="10" Background="White">
                <TextBlock Text="{Binding CurrentView}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#2C3E50"/>
            </Border>
        </Grid>
    </Grid>
</Window>