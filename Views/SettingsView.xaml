<UserControl x:Class="ForVlad.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="700">
    <UserControl.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="MinWidth" Value="120"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="MinWidth" Value="200"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="MinWidth" Value="200"/>
        </Style>
    </UserControl.Resources>
    
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <StackPanel Margin="20" MaxWidth="640">
            <TextBlock Text="Настройки приложения" FontSize="20" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,16"/>
            
            <Border Background="#F8F9FA" BorderBrush="#ECF0F1" BorderThickness="1" CornerRadius="5" Padding="16" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Дней в месяце (расчёты):" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding DaysInMonth, UpdateSourceTrigger=PropertyChanged}"/>
                    
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Размер страницы списков:" VerticalAlignment="Center"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding PageSizeOptions}" SelectedItem="{Binding DefaultPageSize}"/>
                    
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Тема интерфейса:" VerticalAlignment="Center"/>
                    <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding UiTheme}"/>
                    
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Рабочие часы:" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding WorkingHours, UpdateSourceTrigger=PropertyChanged}"
                              ToolTip="Формат: 09:00-18:00"/>
                    
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Валюта по умолчанию:" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding DefaultCurrency, UpdateSourceTrigger=PropertyChanged}"/>
                    
                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Подключение к БД:" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding ConnectionStringDisplay, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="В полной версии — строка подключения SQL Server"/>
                    
                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Версия приложения:" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding AppVersion}" VerticalAlignment="Center" Margin="8,4" FontWeight="SemiBold"/>
                </Grid>
            </Border>
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="💾 Сохранить" Background="#2ECC71" Foreground="White" FontWeight="Bold"
                        Command="{Binding SaveCommand}"/>
                <Button Content="🔄 Сбросить демо-данные" Background="#E74C3C" Foreground="White"
                        Command="{Binding ResetDemoDataCommand}"
                        ToolTip="Восстановить тестовые данные из спецификации"/>
            </StackPanel>
        </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
