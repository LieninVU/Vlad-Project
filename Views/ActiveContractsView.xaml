<UserControl x:Class="ForVlad.Views.ActiveContractsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:ForVlad.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="800">
    
    <UserControl.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="MinWidth" Value="80"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Margin" Value="2"/>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Width" Value="180"/>
        </Style>
        <converters:IntToVisibilityConverter x:Key="IntToVisibilityConverter" />
        <converters:IntToVisibilityInverseConverter x:Key="IntToVisibilityInverseConverter" />
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <Border Grid.Row="0" Background="#F8F9FA" Padding="10" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <Button Content="🔄 Обновить" Background="#3498DB" Foreground="White" Command="{Binding RefreshCommand}"/>
                <Button Content="📊 Экспорт в Excel" Background="#27AE60" Foreground="White"
                        Command="{Binding ExportToExcelCommand}" Margin="10,0,0,0"/>
                <Button Content="🖨️ Печать" Background="#8E44AD" Foreground="White"
                        Command="{Binding PrintCommand}" Margin="10,0,0,0"/>
                <Button Content="🗑️ Очистить фильтры" Background="#95A5A6" Foreground="White"
                        Command="{Binding ClearFiltersCommand}" Margin="10,0,0,0"/>
            </StackPanel>
        </Border>
        
        <Border Grid.Row="1" Background="#ECF0F1" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Номер договора или контрагент" Width="200"/>
                    <TextBlock Text="Период с:" VerticalAlignment="Center" Margin="20,0,10,0"/>
                    <DatePicker SelectedDate="{Binding FilterStartDate}"/>
                    <TextBlock Text="по" VerticalAlignment="Center" Margin="8,0,8,0"/>
                    <DatePicker SelectedDate="{Binding FilterEndDate}"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                    <Border Background="#3498DB" CornerRadius="3" Padding="10,5" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="{Binding TotalContracts}" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Договоров" Foreground="White" FontSize="10" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#2ECC71" CornerRadius="3" Padding="10,5" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="{Binding TotalWithVAT, StringFormat=N0}" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Сумма с НДС" Foreground="White" FontSize="10" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#E74C3C" CornerRadius="3" Padding="10,5">
                        <StackPanel>
                            <TextBlock Text="{Binding ExpiringSoon}" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Истекают ≤30 дн." Foreground="White" FontSize="10" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
        
        <Grid Grid.Row="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Height="400">
                <StackPanel>
                    <DataGrid ItemsSource="{Binding FilteredContracts}"
                              SelectedItem="{Binding SelectedContract}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              GridLinesVisibility="None"
                              RowBackground="#FFFFFF"
                              AlternatingRowBackground="#F8F9FA"
                              HeadersVisibility="Column"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              CanUserResizeRows="False"
                              CanUserSortColumns="True"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Disabled"
                              MinWidth="900"
                              Visibility="{Binding HasContracts, Converter={StaticResource IntToVisibilityConverter}}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Номер" Binding="{Binding ContractNumber}" Width="110" MinWidth="100"/>
                    <DataGridTextColumn Header="Контрагент" Binding="{Binding CounterpartyDisplayName}" Width="170" MinWidth="140"/>
                    <DataGridTemplateColumn Header="Тип" Width="85" MinWidth="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ContractType}" FontWeight="Bold"
                                           Foreground="{Binding ContractType, Converter={StaticResource ContractTypeToColorConverter}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Статус" Width="100" MinWidth="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding Status, Converter={StaticResource StatusToColorConverter}}"
                                        CornerRadius="3" Padding="4,2" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Status}" Foreground="White" FontWeight="SemiBold" FontSize="11"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Начало" Binding="{Binding StartDate, StringFormat=dd.MM.yyyy}" Width="90" MinWidth="85"/>
                    <DataGridTextColumn Header="Окончание" Binding="{Binding EndDate, StringFormat=dd.MM.yyyy}" Width="90" MinWidth="85"/>
                    <DataGridTextColumn Header="Осталось" Binding="{Binding EndDate, Converter={StaticResource DaysRemainingConverter}}" Width="85" MinWidth="80"/>
                    <DataGridTextColumn Header="Сумма" Binding="{Binding TotalAmount, StringFormat=N2}" Width="95" MinWidth="90"/>
                    <DataGridTextColumn Header="С НДС" Binding="{Binding TotalWithVAT, StringFormat=N2}" Width="95" MinWidth="90"/>
                    <DataGridTextColumn Header="Платеж/мес" Binding="{Binding MonthlyPayment, StringFormat=N2}" Width="95" MinWidth="90"/>
                    <DataGridTemplateColumn Header="Действия" Width="75" MinWidth="75">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="👁️" ToolTip="Просмотр" Padding="4,2" FontSize="10"
                                        Command="{Binding DataContext.ViewDetailsFromRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#ECF0F1"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#D6EAF8"/>
                                <Setter Property="BorderBrush" Value="#3498DB"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F2F4F4"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="Transparent"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>
            </DataGrid>

            <Border Background="#F8F9FA"
                    Visibility="{Binding HasContracts, Converter={StaticResource IntToVisibilityInverseConverter}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="📋" FontSize="48" Foreground="#BDC3C7" HorizontalAlignment="Center"/>
                    <TextBlock Text="Действующие договоры не найдены" FontSize="16" Foreground="#7F8C8D" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                    <TextBlock Text="Измените параметры фильтрации" FontSize="12" Foreground="#95A5A6" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        
        <Border Grid.Row="0" Grid.RowSpan="3" Background="#80000000"
                Visibility="{Binding IsDetailsDialogOpen, Converter={StaticResource IntToVisibilityConverter}}">
            <Border Background="White" Width="520" CornerRadius="5" Padding="20"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Просмотр договора" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>
                    <Grid DataContext="{Binding ViewingContract}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Номер:" FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ContractNumber}" Margin="8,0,0,6"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Контрагент:" FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CounterpartyDisplayName}" Margin="8,0,0,6"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Тип / статус:" FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Margin="8,0,0,6">
                            <Run Text="{Binding ContractType}"/><Run Text=" / "/><Run Text="{Binding Status}"/>
                        </TextBlock>
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Период:" FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding PeriodDisplay}" Margin="8,0,0,6"/>
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Сумма с НДС:" FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding TotalWithVAT, StringFormat=N2}" Margin="8,0,0,6"/>
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Платеж/мес:" FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding MonthlyPayment, StringFormat=N2}" Margin="8,0,0,6"/>
                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Условия оплаты:" FontWeight="SemiBold" VerticalAlignment="Top"/>
                        <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding PaymentTerms}" TextWrapping="Wrap" Margin="8,0,0,6"/>
                        <TextBlock Grid.Row="7" Grid.Column="0" Text="Примечания:" FontWeight="SemiBold" VerticalAlignment="Top"/>
                        <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding Notes}" TextWrapping="Wrap" Margin="8,0,0,0"/>
                    </Grid>
                    <Button Content="Закрыть" HorizontalAlignment="Right" Width="100" Margin="0,16,0,0"
                            Background="#3498DB" Foreground="White" Command="{Binding CloseDetailsCommand}"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
