# MSTest test Results
[Tt]est[Rr]esult.xml

# NUnit
*.VisualState.xml

# Visual Studio for Mac
*.userprefs

# SQL Server Database files
*.mdf
*.ldf
*.ndf

# Local History for Visual Studio
.localhistory/

