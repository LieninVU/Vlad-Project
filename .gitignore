# Ignore Visual Studio temporary files, build results, and files generated by popular Visual Studio add-ons.

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/

# NuGet
packages/

# Visual Studio IDE
.vs/
_UpgradeReport_Files/
upgrade.log

# ReSharper
_ReSharper*/
*.[Rr]esharper
*.DotSettings.user

# NCrunch
*.ncrunch*
._NCrunched*

# VS Code
.vscode/

# Test results
[Tt]est[Rr]esult*/
