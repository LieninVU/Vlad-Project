<Application x:Class="ForVlad.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:ForVlad.Converters"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             StartupUri="Views/LoginWindow.xaml">
    <Application.Resources>
        <!-- Подключаем словарь масштабируемых стилей -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/ScalableStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        <!-- Ресурсы конвертеров -->
        <converters:StatusToColorConverter x:Key="StatusToColorConverter" />
        <converters:ContractTypeToColorConverter x:Key="ContractTypeToColorConverter" />
        <converters:BoolToAvailabilityColorConverter x:Key="BoolToAvailabilityColorConverter" />
        <converters:BoolToAvailableTextConverter x:Key="BoolToAvailableTextConverter" />
        <converters:IntToVisibilityConverter x:Key="IntToVisibilityConverter" />
        <converters:IntToVisibilityInverseConverter x:Key="IntToVisibilityInverseConverter" />
        <converters:DaysRemainingConverter x:Key="DaysRemainingConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
