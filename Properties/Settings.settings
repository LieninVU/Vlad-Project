<?xml version='1.0' encoding='utf-8'?>
<SettingsFile xmlns="http://schemas.microsoft.com/VisualStudio/2004/01/settings" CurrentProfile="(Default)">
  <Profiles>
    <Profile Name="(Default)" />
  </Profiles>
  <Settings>
    <Setting Name="DaysInMonth" Type="System.Int32" Scope="User">
      <Value Profile="(Default)">30</Value>
    </Setting>
    <Setting Name="DefaultPageSize" Type="System.Int32" Scope="User">
      <Value Profile="(Default)">25</Value>
    </Setting>
    <Setting Name="UiTheme" Type="System.String" Scope="User">
      <Value Profile="(Default)">Light</Value>
    </Setting>
    <Setting Name="WorkingHours" Type="System.String" Scope="User">
      <Value Profile="(Default)">09:00-18:00</Value>
    </Setting>
    <Setting Name="DefaultCurrency" Type="System.String" Scope="User">
      <Value Profile="(Default)">RUB</Value>
    </Setting>
    <Setting Name="ConnectionStringDisplay" Type="System.String" Scope="User">
      <Value Profile="(Default)">(local)\SQLEXPRESS / LeasingSystem</Value>
    </Setting>
    <Setting Name="ConnectionString" Type="System.String" Scope="User">
      <Value Profile="(Default)">Server=(local)\SQLEXPRESS;Database=LeasingSystem;Integrated Security=True;MultipleActiveResultSets=true;TrustServerCertificate=true;</Value>
    </Setting>
  </Settings>
</SettingsFile>