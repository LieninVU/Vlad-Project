# ============================================
# LeasingSystem - Конфигурация окружения
# ============================================
# Скопируйте этот файл в .env и укажите ваши параметры

# --------------------------------------------
# Подключение к SQL Server
# --------------------------------------------

# Имя сервера SQL Server
# Примеры:
#   (local)\SQLEXPRESS  - SQL Server Express (по умолчанию)
#   localhost\SQLEXPRESS
#   .\SQLEXPRESS
#   (localdb)\MSSQLLocalDB - LocalDB
#   MY-SERVER\SQL2019   - Именованный экземпляр
#   myserver.database.windows.net - Azure SQL
SQL_SERVER=(local)\SQLEXPRESS

# Имя базы данных
# По умолчанию: LeasingSystem
SQL_DATABASE=LeasingSystem

# Тип аутентификации
# Windows - Windows Authentication (Trusted Connection)
# SqlServer - SQL Server Authentication (логин/пароль)
SQL_AUTH_TYPE=Windows

# Логин SQL Server (только если SQL_AUTH_TYPE=SqlServer)
SQL_USERNAME=

# Пароль SQL Server (только если SQL_AUTH_TYPE=SqlServer)
SQL_PASSWORD=

# --------------------------------------------
# Дополнительные параметры подключения
# --------------------------------------------

# Таймаут подключения (в секундах)
SQL_CONNECTION_TIMEOUT=30

# Доверять сертификату сервера (true/false)
SQL_TRUST_CERTIFICATE=true

# Использовать шифрование (true/false)
SQL_ENCRYPT=false

# --------------------------------------------
# Настройки приложения
# --------------------------------------------

# Дней в месяце для расчётов (по умолчанию: 30)
DAYS_IN_MONTH=30

# Размер страницы списков (по умолчанию: 50)
PAGE_SIZE=50

# Тема интерфейса (Light/Dark)
UI_THEME=Light

# --------------------------------------------
# Режим работы
# --------------------------------------------

# Режим базы данных
# Production - использовать реальную БД SQL Server
# Demo - использовать демонстрационные данные в памяти
DB_MODE=Production

# Включить логирование SQL-запросов (true/false)
SQL_LOGGING=false
