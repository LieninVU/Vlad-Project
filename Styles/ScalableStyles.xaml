<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Базовый размер шрифта -->
    <sys:Double x:Key="ScalableFontSize">14</sys:Double>
    <sys:Double x:Key="ScalableHeaderFontSize">18</sys:Double>
    <sys:Double x:Key="ScalableSmallFontSize">11</sys:Double>
    
    <!-- Стиль для кнопок с относительными размерами -->
    <Style TargetType="Button" x:Key="ScalableButton">
        <Setter Property="FontSize" Value="{DynamicResource ScalableFontSize}"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="MinWidth" Value="80"/>
    </Style>
    
    <!-- Стиль для текстовых полей -->
    <Style TargetType="TextBox" x:Key="ScalableTextBox">
        <Setter Property="FontSize" Value="{DynamicResource ScalableFontSize}"/>
        <Setter Property="Padding" Value="4"/>
    </Style>
    
    <!-- Стиль для DataGrid -->
    <Style TargetType="DataGrid" x:Key="ScalableDataGrid">
        <Setter Property="FontSize" Value="{DynamicResource ScalableFontSize}"/>
        <Setter Property="RowHeight" Value="NaN"/>
        <Setter Property="MinRowHeight" Value="25"/>
    </Style>
    
    <!-- Стиль для TextBlock -->
    <Style TargetType="TextBlock" x:Key="ScalableTextBlock">
        <Setter Property="FontSize" Value="{DynamicResource ScalableFontSize}"/>
    </Style>

</ResourceDictionary>
